# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Generated by `npm run cf-typegen` (runs automatically before typecheck)
src/worker/worker-configuration.d.ts

# Local Workers runtime state: per-cell SQLite databases, caches, logs
.wrangler/
.mf/
.test-state/

# Local secrets and environment files (never commit)
.env
.env.*
.dev.vars
.dev.vars.*
!.env.example
!.dev.vars.example

# Local databases created by hand or by tools
*.sqlite
*.sqlite3
*.db

# Test and tooling artefacts
coverage/
playwright-report/
test-results/
*.log

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
