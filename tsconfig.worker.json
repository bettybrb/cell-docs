// and the Vitest tests that execute inside workerd.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/worker", "src/shared", "test/worker"]
}
