// Wrangler configuration for cell-docs-lab.
// Used by `wrangler`, by the Cloudflare Vite plugin during `npm run dev`,
// and by the Workers Vitest pool during `npm test`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cell-docs-lab",
  "main": "src/worker/index.ts",
  // Must be supported by every local workerd build we use (dev server and test pool).
  "compatibility_date": "2026-08-01",

  // Static frontend assets. Any path that is not an API route falls back to the
  // React single-page app; `/api/*` always runs the Worker first.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Each binding is a "namespace" of cells. The Worker addresses an individual
  // cell inside a namespace by name (see src/worker/addressing.ts).
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE_CELL", "class_name": "WorkspaceCell" },
      { "name": "DOC_CELL", "class_name": "DocCell" },
      { "name": "SHEET_CELL", "class_name": "SheetCell" }
    ]
  },

  // `new_sqlite_classes` makes these Durable Objects SQLite-backed:
  // every instance gets its own private SQLite database.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceCell", "DocCell"] },
    { "tag": "v2", "new_sqlite_classes": ["SheetCell"] }
  ],

  // How long a deleted document stays in the Recycle Bin before it is erased
  // (30 days). Override it in .dev.vars, e.g. TRASH_RETENTION_MS=60000, to
  // watch permanent deletion happen while testing by hand.
  "vars": { "TRASH_RETENTION_MS": "2592000000" },

  "observability": { "enabled": true }
}
